{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slurry-game",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "VISITORS", "class_name": "VisitorCounter" },
      { "name": "SHOWCASE", "class_name": "Showcase" }
    ]
  },
  "migrations": [
    { "tag": "visitors-v1", "new_sqlite_classes": ["VisitorCounter"] },
    { "tag": "showcase-v1", "new_sqlite_classes": ["Showcase"] }
  ]
}
